{
  "name": "tianji-ai-xuanpin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["extension"],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:extension": "npm run dev --workspace extension",
    "build": "npm run build:web && npm run build:extension",
    "build:web": "tsc -b && vite build",
    "build:extension": "npm run build --workspace extension",
    "typecheck:extension": "npm run compile --workspace extension",
    "test": "npm run test:extension",
    "test:extension": "npm test --workspace extension",
    "lint": "oxlint src vite.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
